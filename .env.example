APP_ENV=development
PORT=8080
LOG_LEVEL=debug

# Use a Supabase connection string in cloud environments.
# The Docker Compose value below is for local development only.
DATABASE_URL=postgres://multibook:multibook@localhost:5432/multibook?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=2

FIREBASE_PROJECT_ID=your-firebase-project-id
# For local development, point this at a service-account JSON file excluded by .gitignore.
GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account.json

# Comma-separated list. Do not use * outside local development.
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
